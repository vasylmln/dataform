config {
  type: "view",
  schema: "Datamart",
  name: "MedOpsSchedules",
  description: "Detailed daily timeslots scheduled for work for employees of the Medical Operations department, including timeslot durations.",
  columns: {
    work_date: "Date of the schedule",
    user_name: "Name of the Medical Operations employee",
    user_email: "Standardized email of the employee",
    from_time: "Start time of the scheduled working session",
    to_time: "End time of the scheduled working session",
    duration_minutes: "The duration of this specific working timeslot in minutes",
    schedule_name: "Name of the Calendly availability schedule"
  },
  metadata: {
    overview: "This table/view expands weekly and date-specific Calendly availability rules into discrete working timeslots per day for active Medical Operations employees across the year 2026, including the duration in minutes for each timeslot.",
    extraProperties: {
      generic: {
        type: "Datamart",
        system: "calendly"
      }
    }
  },
  tags: ["auto-cleaning"]
}

WITH
  base_data AS (
    SELECT
      users.user_name,
      users.user_email,
      emp.department_name,
      schedules.schedule_name,
      rules.weekday_name AS wday,
      rules.rule_specific_date AS date,
      rules.start_time_of_day AS from_time,
      rules.end_time_of_day AS to_time,
      CONCAT(rules.start_time_of_day, " - ",  rules.end_time_of_day) AS from_time_to_time
    FROM ${ref("stg_calendly_users")} AS users
    INNER JOIN ${ref("stg_calendly_availability_schedules")} AS schedules
      ON users.user_uri = schedules.user_uri
    INNER JOIN ${ref("stg_calendly_availability_schedule_rules")} AS rules
      ON schedules.schedule_uri = rules.schedule_uri
    INNER JOIN ${ref("stg_personio_employees")} AS emp
      ON users.user_email = emp.email
    WHERE
      COALESCE(users.is_deleted, FALSE) IS FALSE
      AND emp.department_name = 'Medical Operations'
      AND COALESCE(emp.is_deleted, FALSE) IS FALSE
  ),

  calendar_2026 AS (
    SELECT day, FORMAT_DATE('%A', day) AS day_name
    FROM UNNEST(GENERATE_DATE_ARRAY('2026-01-01', '2026-12-31')) AS day
  )

SELECT
  bd.user_name,
  bd.user_email,
  department_name,
  COALESCE(SAFE_CAST(bd.date AS DATE), c.day) AS work_date,
  bd.from_time,
  bd.to_time,
  bd.from_time_to_time,
  TIME_DIFF(bd.to_time, bd.from_time, MINUTE)/60 AS duration_hours,
  bd.schedule_name
FROM base_data bd
LEFT JOIN calendar_2026 c
  ON bd.date IS NULL 
  AND bd.wday IS NOT NULL 
  AND bd.wday = LOWER(c.day_name)
WHERE bd.date IS NOT NULL OR c.day IS NOT NULL
ORDER BY work_date DESC, user_email, from_time
