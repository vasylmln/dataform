config {
  type: "table",
  schema: "wellis-400118",  // Target dataset in BigQuery
  name: "DWH",
  description: "Cleaned fact table of scheduled Calendly events",
  columns: {
    event_uri: "Unique URI identifier for the event",
    event_name: "Name of the scheduled event"
  },
  assertions: {
    uniqueKey: ["event_uri"],
    nonNull: ["event_uri"]
  }
}

SELECT
  uri AS event_uri,
  event_type_uri,
  name AS event_name,
  status,
  start_time,
  end_time,
  TIMESTAMP_DIFF(end_time, start_time, MINUTE) AS duration_minutes,
  created_at,
  CASE 
    WHEN status = 'canceled' OR cancel_reason IS NOT NULL THEN TRUE 
    ELSE FALSE 
  END AS is_canceled
FROM
  ${ref("event")}
WHERE
  COALESCE(_fivetran_deleted, FALSE) IS FALSE